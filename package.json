{
  "name": "certchain",
  "version": "1.0.0",
  "description": "Blockchain-based certificate verification (Solidity + Polygon + React + Web3.js)",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "frontend": "npm --prefix frontend run dev",
    "postinstall": "npm --prefix frontend install"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10"
  }
}
